      "content": "import React, { useEffect, useState } from 'react';\n\nfunction App() {\n  const [unis, setUnis] = useState([]);\n  const [selectedUni, setSelectedUni] = useState('');\n  const [question, setQuestion] = useState('');\n  const [answer, setAnswer] = useState(null);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    fetch('http://localhost:4000/api/universities')\n      .then(r => r.json())\n      .then(setUnis)\n      .catch(() => setUnis([]));\n  }, []);\n\n  async function handleSolve(e) {\n    e.preventDefault();\n    setLoading(true);\n    setAnswer(null);\n    const res = await fetch('http://localhost:4000/api/solve', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ question, university: selectedUni }) });\n    const data = await res.json();\n    setAnswer(data);\n    setLoading(false);\n  }\n\n  return (\n    <div style={{ padding: 20, fontFamily: 'sans-serif' }}>\n      <h1>BCA Study — Demo PWA</h1>\n\n      <div>\n        <label>University: </label>\n        <select value={selectedUni} onChange={e => setSelectedUni(e.target.value)}>\n          <option value=\"\">All Universities</option>\n          {unis.map(u => <option key={u.id} value={u.id}>{u.name}</option>)}\n        </select>\n      </div>\n\n      <form onSubmit={handleSolve} style={{ marginTop: 12 }}>\n        <textarea rows={6} cols={80} value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Type your BCA question here...\"></textarea>\n        <div>\n          <button disabled={loading || !question}>{loading ? 'Solving...' : 'Solve'}</button>\n        </div>\n      </form>\n\n      {answer && (\n        <div style={{ marginTop: 20 }}>\n          <h3>Result (source: {answer.source})</h3>\n          <pre style={{ whiteSpace: 'pre-wrap', background: '#f6f6f6', padding: 10 }}>{JSON.stringify(answer.result, null, 2)}</pre>\n        </div>\n      )}\n\n      <hr />\n      <h2>Important sector (bundled demo)</h2>\n      <p>This scaffold bundles a small Important-sector sample. Full national data will be populated by the ingestion pipeline.</p>\n    </div>\n  );\n}\n\nexport default App;\n",
      "path": "frontend/src/App.js"
    },
