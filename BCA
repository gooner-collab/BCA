      "content": "require('dotenv').config();\nconst express = require('express');\nconst cors = require('cors');\nconst fetch = require('node-fetch');\nconst bcrypt = require('bcrypt');\nconst jwt = require('jsonwebtoken');\nconst fs = require('fs');\nconst path = require('path');\nconst { v4: uuidv4 } = require('uuid');\nconst sqlite3 = require('sqlite3').verbose();\n\nconst DB_PATH = path.join(__dirname, '..', 'data', 'app.db');\nif (!fs.existsSync(path.join(__dirname, '..', 'data'))) fs.mkdirSync(path.join(__dirname, '..', 'data'));\nconst db = new sqlite3.Database(DB_PATH);\n\n// Simple DB initialization (users, universities, syllabus_snapshots)\ndb.serialize(() => {\n  db.run(`CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT UNIQUE, password_hash TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);\n  db.run(`CREATE TABLE IF NOT EXISTS universities (id TEXT PRIMARY KEY, name TEXT, country TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);\n  db.run(`CREATE TABLE IF NOT EXISTS syllabus_snapshots (id TEXT PRIMARY KEY, university_id TEXT, year INTEGER, semester TEXT, raw JSON, source_url TEXT, source_hash TEXT, parsed_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);\n});\n\nconst app = express();\napp.use(cors());\napp.use(express.json());\n\nconst JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-change-me';\nconst LOCAL_LLM_URL = process.env.LOCAL_LLM_URL || '';\n\n// --- Helper functions ---\nfunction createToken(userId) {\n  return jwt.sign({ sub: userId }, JWT_SECRET, { expiresIn: '7d' });\n}\n\n// --- Auth routes (simple) ---\napp.post('/api/auth/register', async (req, res) => {\n  const { email, password } = req.body;\n  if (!email || !password) return res.status(400).json({ error: 'email & password required' });\n  const id = uuidv4();\n  const password_hash = await bcrypt.hash(password, 10);\n  db.run(`INSERT INTO users (id, email, password_hash) VALUES (?, ?, ?)`, [id, email, password_hash], function (err) {\n    if (err) return res.status(400).json({ error: 'email already exists' });\n    const token = createToken(id);\n    res.json({ token, user: { id, email } });\n  });\n});\n\napp.post('/api/auth/login', (req, res) => {\n  const { email, password } = req.body;\n  if (!email || !password) return res.status(400).json({ error: 'email & password required' });\n  db.get(`SELECT id, password_hash FROM users WHERE email = ?`, [email], async (err, row) => {\n    if (err || !row) return res.status(401).json({ error: 'invalid credentials' });\n    const ok = await bcrypt.compare(password, row.password_hash);\n    if (!ok) return res.status(401).json({ error: 'invalid credentials' });\n    const token = createToken(row.id);\n    res.json({ token, user: { id: row.id, email } });\n  });\n});\n\n// --- Universities / syllabus endpoints (sample) ---\napp.get('/api/universities', (req, res) => {\n  db.all(`SELECT id, name, country FROM universities ORDER BY name LIMIT 100`, [], (err, rows) => {\n    if (err) return res.status(500).json({ error: 'db error' });\n    res.json(rows);\n  });\n});\n\n// Seed a few sample universities if none exist\nfunction seedUniversities() {\n  db.get(`SELECT COUNT(*) AS cnt FROM universities`, (err, row) => {\n    if (row && row.cnt === 0) {\n      const sample = [\n        { id: 'uni-osmania', name: 'Osmania University', country: 'India' },\n        { id: 'uni-delhi', name: 'University of Delhi', country: 'India' },\n        { id: 'uni-mumbai', name: 'University of Mumbai', country: 'India' },\n      ];\n      const stmt = db.prepare(`INSERT INTO universities (id, name, country) VALUES (?, ?, ?)`);\n      sample.forEach(u => stmt.run(u.id, u.name, u.country));\n      stmt.finalize();\n    }\n  });\n}\nseedUniversities();\n\n// List syllabus snapshots for a university\napp.get('/api/universities/:id/snapshots', (req, res) => {\n  const id = req.params.id;\n  db.all(`SELECT id, year, semester, parsed_at FROM syllabus_snapshots WHERE university_id = ? ORDER BY parsed_at DESC LIMIT 50`, [id], (err, rows) => {\n    if (err) return res.status(500).json({ error: 'db error' });\n    res.json(rows);\n  });\n});\n\n// Solver endpoint: prefer local LLM server if configured, otherwise return a mocked response\napp.post('/api/solve', async (req, res) => {\n  const { question, university, year, semester } = req.body;\n  if (!question) return res.status(400).json({ error: 'question required' });\n\n  const prompt = `You are a BCA study assistant. Answer the question step-by-step. University: ${university || 'any'}, Year: ${year || 'any'}, Semester: ${semester || 'any'}. Question: ${question}`;\n\n  try {\n    if (LOCAL_LLM_URL) {\n      // Forward prompt to local LLM server (assumed to accept JSON {prompt})\n      const r = await fetch(LOCAL_LLM_URL, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ prompt }),\n      });\n      if (!r.ok) {\n        const text = await r.text();\n        return res.status(502).json({ error: 'local-llm-failed', details: text });\n      }\n      const data = await r.json();\n      // Expected: { answer: '...' } but pass through whatever the local model returns\n      return res.json({ success: true, source: 'local-llm', result: data });\n    } else {\n      // Mocked fallback: deterministic structured response for demo and offline builds\n      const result = {\n        explanation: `Mocked answer for: ${question}`,\n        steps: [\n          'Read and understand the question carefully.',\n          'Break the problem into smaller parts and list relevant syllabus topics.',\n          'Solve step-by-step, showing intermediate calculations or code where relevant.',\n          'Summarize the final answer and provide 3 practice MCQs.'\n        ],\n        references: [\n          { university: university || 'Multiple', year: year || '2026+', topic: 'See syllabus sector' }\n        ],\n        mcqs: [\n          { q: 'Sample MCQ 1', choices: ['A','B','C','D'], answer: 'A' },\n          { q: 'Sample MCQ 2', choices: ['A','B','C','D'], answer: 'B' },\n          { q: 'Sample MCQ 3', choices: ['A','B','C','D'], answer: 'C' }\n        ]\n      };\n      return res.json({ success: true, source: 'mock', result });\n    }\n  } catch (err) {\n    console.error('solve error', err);\n    res.status(500).json({ error: 'server error', details: err.toString() });\n  }\n});\n\n// Admin: ingest helper (manual) to store a snapshot (simple)\napp.post('/api/admin/ingest', (req, res) => {\n  const { university_id, year, semester, raw, source_url } = req.body;\n  if (!university_id || !raw) return res.status(400).json({ error: 'university_id and raw required' });\n  const id = uuidv4();\n  const source_hash = require('crypto').createHash('sha256').update(JSON.stringify(raw)).digest('hex');\n  db.run(`INSERT INTO syllabus_snapshots (id, university_id, year, semester, raw, source_url, source_hash) VALUES (?, ?, ?, ?, ?, ?, ?)`, [id, university_id, year || null, semester || null, JSON.stringify(raw), source_url || null, source_hash], function (err) {\n    if (err) return res.status(500).json({ error: 'db error', details: err.toString() });\n    res.json({ success: true, id });\n  });\n});\n\nconst port = process.env.PORT || 4000;\napp.listen(port, () => console.log(`Backend running on http://localhost:${port}`));\n",
      "path": "backend/server.js"
